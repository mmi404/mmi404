# Copy to docker/.env.prod (gitignored) and fill in. Never commit real values.
#   cp docker/.env.prod.example docker/.env.prod && chmod 600 docker/.env.prod

# MySQL passwords: any long random strings.   openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT signing secret, at least 32 bytes.        openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=

# The real admin login for /admin. Created on first boot only if admin_user is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
